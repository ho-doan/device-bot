<Window x:Class="win_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit — Your space to focus" Width="1280" Height="860"
        MinWidth="360" MinHeight="480" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="16" Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}" Loaded="WindowLoaded" SizeChanged="WindowSizeChanged">
    <Grid>
        <Grid x:Name="AuthLayout" Visibility="{Binding IsAuth, Converter={StaticResource VisibleWhen}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WelcomeColumn" Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="WelcomePanel" Background="#123D37" CornerRadius="28" Padding="40" Margin="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="32" Height="32" Margin="0,0,10,0">
                            <Ellipse Stroke="White" StrokeThickness="3"/>
                            <Ellipse Width="6" Height="6" Fill="White" Margin="7,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                        <TextBlock Text="orbit" Foreground="White" FontSize="30" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,40,0,32">
                        <TextBlock Text="Good work starts with a clear mind." FontSize="44" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Your plans, projects, and small wins. Together, in one calm space." Foreground="#C5E3D6" FontSize="18" LineHeight="28" Margin="0,24,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <Border Background="#F2F5DC" CornerRadius="24" Padding="28">
                            <StackPanel>
                                <TextBlock Text="A LITTLE FOCUS GOES A LONG WAY" FontSize="11" Foreground="#123D37"/>
                                <TextBlock Text="One thing at a time.&#10;One step closer." FontSize="28" FontWeight="SemiBold" Foreground="#123D37" Margin="0,24,0,24"/>
                                <ProgressBar Value="68" Maximum="100" Height="6" Foreground="#086B61" Background="#D5DFC8" IsTabStop="False"/>
                                <TextBlock Text="Progress, at your own pace." Foreground="#38594F" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="LESS FRICTION. MORE FLOW." FontSize="11" Foreground="#C5E3D6" Margin="0,28,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          VerticalContentAlignment="Center" AutomationProperties.AutomationId="orbit-viewport">
                <StackPanel x:Name="AuthContent" MaxWidth="420" Margin="40" HorizontalAlignment="Center" KeyboardNavigation.TabNavigation="Continue">
                    <TextBlock Text="orbit" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,40"/>
                    <StackPanel Visibility="{Binding ShowForm, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="YOUR SPACE TO FOCUS" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="{Binding AuthHeading}" Style="{StaticResource Heading}"/>
                        <TextBlock Text="{Binding AuthDescription}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,24"/>
                        <Border Background="{DynamicResource ErrorBackgroundBrush}" CornerRadius="12" Margin="0,0,0,16"
                                Visibility="{Binding HasMessage, Converter={StaticResource VisibleWhen}}">
                            <TextBlock x:Name="ErrorSummary" Text="{Binding Message}" Foreground="{DynamicResource OnErrorBrush}" Margin="16"
                                       Focusable="True" KeyboardNavigation.IsTabStop="False" AutomationProperties.LiveSetting="Assertive"/>
                        </Border>
                        <Label Content="Email address" Target="{Binding ElementName=EmailInput}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,8"/>
                        <TextBox x:Name="EmailInput" Style="{StaticResource EmailEditor}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}"
                                 KeyDown="EmailKeyDown" AutomationProperties.AutomationId="email-field" AutomationProperties.Name="Email address"/>
                        <TextBlock Text="{Binding EmailError}" Foreground="{DynamicResource ErrorBrush}" Margin="0,6,0,0"
                                   AutomationProperties.LiveSetting="Polite" Visibility="{Binding HasEmailError, Converter={StaticResource VisibleWhen}}"/>
                        <StackPanel Visibility="{Binding IsLogin, Converter={StaticResource VisibleWhen}}" Margin="0,20,0,0">
                            <Label Content="Password" Target="{Binding ElementName=PasswordInput}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <PasswordBox x:Name="PasswordInput" Style="{StaticResource SecretPasswordEditor}" PasswordChanged="PasswordChanged" IsEnabled="{Binding CanEdit}" KeyDown="PasswordKeyDown"
                                             Visibility="{Binding PasswordHidden, Converter={StaticResource VisibleWhen}}"
                                             AutomationProperties.AutomationId="password-field" AutomationProperties.Name="Password"/>
                                <TextBox x:Name="VisiblePasswordInput" Style="{StaticResource VisiblePasswordEditor}" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}"
                                         KeyDown="PasswordKeyDown" Visibility="{Binding PasswordVisible, Converter={StaticResource VisibleWhen}}"
                                         AutomationProperties.AutomationId="password-field" AutomationProperties.Name="Password"/>
                                <Button Grid.Column="1" Content="{Binding ToggleLabel}" Click="TogglePasswordClicked" Style="{StaticResource QuietButton}" Padding="10,4" Margin="8,0,0,0"
                                        AutomationProperties.AutomationId="password-visibility-control" AutomationProperties.Name="{Binding ToggleLabel}"/>
                            </Grid>
                            <TextBlock Text="{Binding PasswordError}" Foreground="{DynamicResource ErrorBrush}" Margin="0,6,0,0"
                                       Visibility="{Binding HasPasswordError, Converter={StaticResource VisibleWhen}}"/>
                            <Button Content="Forgot password?" Click="ForgotPasswordClicked" IsEnabled="{Binding CanEdit}"
                                    Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Margin="0,8,0,12"
                                    AutomationProperties.AutomationId="forgot-password-button"/>
                        </StackPanel>
                        <Button Content="{Binding SubmitLabel}" Click="SubmitClicked" IsEnabled="{Binding CanEdit}" Margin="0,16,0,0"
                                AutomationProperties.AutomationId="submit-button"/>
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0" Foreground="{DynamicResource PrimaryBrush}"
                                     Visibility="{Binding Busy, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Please wait"/>
                        <Button Content="Back to sign in" Click="BackToLoginClicked" IsEnabled="{Binding CanEdit}" Style="{StaticResource QuietButton}" Margin="0,12,0,0"
                                Visibility="{Binding IsReset, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="back-to-sign-in-button"/>
                        <Border Style="{StaticResource Card}" Margin="0,24,0,0" Visibility="{Binding IsLogin, Converter={StaticResource VisibleWhen}}">
                            <StackPanel>
                                <TextBlock Text="Just exploring?" FontWeight="SemiBold"/>
                                <TextBlock Text="A ready-to-use workspace. No account needed." Margin="0,12,0,12"/>
                                <TextBox Text="{Binding DemoCredentials, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                         IsTabStop="False" AutomationProperties.Name="Demo credentials"/>
                                <Button Content="Try demo workspace" Click="TryDemoClicked" IsEnabled="{Binding CanEdit}" Style="{StaticResource OutlineButton}" Margin="0,12,0,0"
                                        AutomationProperties.AutomationId="demo-button"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Demo mode · Your session ends when the app restarts." Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,12,0,0"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding ResetSent, Converter={StaticResource VisibleWhen}}">
                        <TextBlock x:Name="ResetHeading" Text="You’re all set." Style="{StaticResource Heading}" Focusable="True" KeyboardNavigation.IsTabStop="False"/>
                        <TextBlock Text="Reset request simulated. This demo does not send email or change your password." Margin="0,0,0,24"/>
                        <Button Content="Back to sign in" Click="BackToLoginClicked" AutomationProperties.AutomationId="back-to-sign-in-button"/>
                    </StackPanel>
                    <TextBlock Text="A little less noise. A lot more focus." Foreground="{DynamicResource MutedBrush}" Margin="0,32,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Visibility="{Binding IsWorkspace, Converter={StaticResource VisibleWhen}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="24,12">
                <TextBlock Text="orbit" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                <Button Content="AL" Click="AccountClicked" HorizontalAlignment="Right" Width="48" Height="48" Padding="0" Background="{DynamicResource ContainerBrush}"
                        Foreground="{DynamicResource OnContainerBrush}" AutomationProperties.AutomationId="account-avatar-control" AutomationProperties.Name="Your account"/>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="NavigationRail" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,1,0" Padding="8,12">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Bottom" Content="Sign out" Click="SignOutClicked" Style="{StaticResource QuietButton}"
                                AutomationProperties.AutomationId="rail-sign-out-control"/>
                        <StackPanel>
                            <Button x:Name="OverviewRail" Content="Overview" Click="OverviewClicked" Style="{StaticResource QuietButton}" Margin="0,0,0,8"
                                    AutomationProperties.AutomationId="overview-navigation" AutomationProperties.Name="Overview"/>
                            <Button x:Name="AccountRail" Content="Account" Click="AccountClicked" Style="{StaticResource QuietButton}"
                                    AutomationProperties.AutomationId="account-navigation" AutomationProperties.Name="Account"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ScrollViewer x:Name="WorkspaceScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="orbit-viewport">
                    <Grid x:Name="WorkspaceContent" MaxWidth="1040" Margin="40" HorizontalAlignment="Stretch">
                        <StackPanel Visibility="{Binding IsHome, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="YOUR WORKSPACE" Style="{StaticResource Eyebrow}"/>
                            <TextBlock x:Name="HomeHeading" Text="A fresh start, Alex." Style="{StaticResource Heading}" Focusable="True" KeyboardNavigation.IsTabStop="False"/>
                            <TextBlock Text="Let’s make a little progress on what matters." Foreground="{DynamicResource MutedBrush}" FontSize="18" Margin="0,0,0,24"/>
                            <Border Background="{DynamicResource ContainerBrush}" CornerRadius="24" Padding="28" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="Find your flow." Foreground="{DynamicResource OnContainerBrush}" FontSize="28" FontWeight="SemiBold"/>
                                    <TextBlock Text="Big ideas begin with small, intentional steps. Your next one is right here." Foreground="{DynamicResource OnContainerBrush}" Margin="0,16,0,16"/>
                                    <Button Content="View your profile" Click="AccountClicked" HorizontalAlignment="Left" AutomationProperties.AutomationId="view-profile-button"/>
                                </StackPanel>
                            </Border>
                            <UniformGrid x:Name="StatsPanel" Columns="3" Margin="-6,0,-6,18">
                                <Border Style="{StaticResource Card}" Margin="6"><StackPanel><TextBlock Text="{Binding CompletedSummary}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Small wins" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="6"><StackPanel><TextBlock Text="20 min" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Time for yourself" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="6"><StackPanel><TextBlock Text="Today" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="A good day to begin" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
                            </UniformGrid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="A little plan for today" FontSize="24" FontWeight="SemiBold"/>
                                    <TextBlock Text="Check things off. Enjoy the small wins." Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,20"/>
                                    <ItemsControl ItemsSource="{Binding Tasks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" MinHeight="64" Padding="12,8" VerticalContentAlignment="Center" Margin="0,0,0,8"
                                                          AutomationProperties.AutomationId="{Binding Id}" AutomationProperties.Name="{Binding Title}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="16">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Description}" FontSize="14" Foreground="{DynamicResource MutedBrush}"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ProgressBar Value="{Binding CompletedCount}" Maximum="3" Height="8" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource OutlineBrush}"
                                                 AutomationProperties.Name="{Binding ProgressDescription}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsAccount, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="YOUR ACCOUNT" Style="{StaticResource Eyebrow}"/>
                            <TextBlock x:Name="AccountHeading" Text="Your account" Style="{StaticResource Heading}" Focusable="True" KeyboardNavigation.IsTabStop="False"/>
                            <TextBlock Text="A familiar face in your own little space." Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,24"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource ContainerBrush}" HorizontalAlignment="Left">
                                        <TextBlock Text="AL" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource OnContainerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Alex Lane" FontSize="28" FontWeight="SemiBold" Margin="0,24,0,12"/>
                                    <TextBox Text="alex@orbit.demo" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" HorizontalAlignment="Left" AutomationProperties.Name="Email address"/>
                                    <Button Content="Sign out" Click="SignOutClicked" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Margin="0,24,0,0" AutomationProperties.AutomationId="sign-out-button"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
            <Border x:Name="BottomNavigation" Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource OutlineBrush}" Padding="12,8">
                <UniformGrid Columns="2">
                    <Button x:Name="OverviewBottom" Content="Overview" Click="OverviewClicked" Style="{StaticResource QuietButton}" AutomationProperties.AutomationId="overview-navigation"/>
                    <Button x:Name="AccountBottom" Content="Account" Click="AccountClicked" Style="{StaticResource QuietButton}" AutomationProperties.AutomationId="account-navigation"/>
                </UniformGrid>
            </Border>
        </Grid>

        <StackPanel Visibility="{Binding IsNotFound, Converter={StaticResource VisibleWhen}}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="520">
            <TextBlock Text="This page is outside your orbit." Style="{StaticResource Heading}"/>
            <TextBlock Text="Let’s get you back to a familiar place." Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,24"/>
            <Button Content="Back to home" Click="OverviewClicked" AutomationProperties.AutomationId="back-to-home-button"/>
        </StackPanel>
    </Grid>
</Window>
