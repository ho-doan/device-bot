version: 2
name: qc_live_step_reorder
description: |
  EC-16: Step reorder/insert in review dialog.
  Record 4 actions → review → try to drag step 3 before step 1 (if UI supports) →
  verify YAML preview updates OR note feature gap if not supported.
steps:
  - run: {recipe: open_qc_live}
  - run: {recipe: live_scroll_pair}  # 1-2
  - run: {recipe: select_live_search}  # 3
  - run: {recipe: send_live_text, with: {text: 'reorder test'}}  # 4
  - assert_element: {label: Review YAML (4), element_type: button, source: flutter}
  - tap_element: {label: Review YAML (4), element_type: button, source: flutter}
  - assert_element: {filter: '4 recorded actions.', source: flutter}
  - screenshot: {path: reorder-steps-before.png}
  # Attempt drag reorder (if UI supports; flutter test may not expose reordering yet)
  - tap_element: {label: YAML, source: flutter}
  - assert_element: {resource_id: recording-yaml-preview, filter: 'reorder test', source: flutter}
  # If reordering is not supported in current UI, this step will be skipped with feature gap note
  - screenshot: {path: reorder-yaml-preview.png}
  - tap_element: {label: Back, element_type: button, source: flutter}
  - tap_element: {label: Run on device, element_type: button, source: flutter}
  - launch_app: {app_id: '${app_id}'}
  - assert_element: {resource_id: recording-run-result, filter: 'Run PASS', source: flutter, timeout_ms: 60000}
